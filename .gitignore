# ==========================================
# Dependency Directories
# ==========================================
# Ignore installed node modules. These should be generated locally via 'npm install'.
node_modules/

# ==========================================
# Environment Variables
# ==========================================
# Ignore environment files containing sensitive keys, passwords, and DB URIs.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Logs
# ==========================================
# Ignore auto-generated log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# OS Generated Files
# ==========================================
# Ignore system files created by macOS and Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
