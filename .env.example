# ==========================================
# Environment Variable Template
# ==========================================
# Duplicate this file, rename it to '.env', and fill in the actual values.
# DO NOT commit the real '.env' file to version control.

# The port the Express server will listen on (e.g., 3000 or 8080)
PORT=3000

# The current environment ('development', 'production', or 'test')
# Used to determine logging levels, error display, etc.
NODE_ENV=development

# The connection string for your MongoDB database.
# Replace with your local URI (e.g., mongodb://localhost:27017/myapp) or Atlas URI.
MONGODB_URI=mongodb://localhost:27017/your_database_name
# Cloudinary vars
CLOUD_NAME=aaaaaaaa
UPLOAD_PRESET=upload-preset
